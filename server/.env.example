MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/lms?appName=Cluster0
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Auth — 'google' is the production mode. 'mock' is only useful when developing
# locally without internet access. With 'google', the client must send a real
# Google ID token to /api/auth/google.
AUTH_PROVIDER=google

# Google OAuth 2.0 — get these from Google Cloud Console
# (APIs & Services → Credentials → Create OAuth client ID → Web application)
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# The one account that's allowed to bootstrap as admin. Anyone else must be
# provisioned by an admin before they can sign in.
ADMIN_EMAIL=saihrudhay9@gmail.com

# OpenAI — powers the student AI tutor widget.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo
